# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:clave@localhost:5432/crm_erasmus?schema=public"

# Secreto de sesión (genera uno: openssl rand -base64 32)
AUTH_SECRET="genera-un-secreto-seguro"

# Microsoft Graph (envío de correo). Dejar vacío hasta configurar en Azure AD.
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""
AZURE_SENDER_EMAIL=""

# Credenciales del admin inicial (solo las usa `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@tudominio.es"
SEED_ADMIN_PASSWORD="elige-una-contrasena-segura"
