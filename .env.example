# ---------------------------------------------------------------------------
# Configuración del CRM. Copia este fichero a `.env` y rellena los valores.
#
# NUNCA subas el `.env` al repositorio (ya está en .gitignore) ni lo metas en
# la imagen de Docker (está en .dockerignore). Todos los secretos van aquí,
# jamás escritos dentro del código.
# ---------------------------------------------------------------------------

# === Dirección pública (obligatoria en producción) =========================
# Con https:// y sin barra final. Se usa para la protección anti-CSRF.
# Ejemplo: APP_ORIGIN="https://crm.novaschool.es"
# En desarrollo local puede quedar vacía.
APP_ORIGIN=""

# === Base de datos =========================================================
# Solo para desarrollo local o despliegue SIN Docker. Con Docker Compose esta
# cadena la construye el propio compose a partir de las POSTGRES_* de abajo.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/crm_erasmus?schema=public"

# === Base de datos, solo para el despliegue con Docker Compose =============
# POSTGRES_PASSWORD es OBLIGATORIA: sin ella `docker compose up` se niega a
# arrancar (para que nadie despliegue con una clave por defecto conocida).
#
# IMPORTANTE: usa SOLO letras y números. Esta contraseña se inserta dentro de
# la URL de conexión (postgresql://usuario:CLAVE@db:5432/...), y un carácter
# "/" la rompe con un error confuso. Genérala así:
#
#     openssl rand -hex 24
#
# NO uses "openssl rand -base64": produce "/" y "+" a menudo (más de la mitad
# de las veces), y con "/" la aplicación no arranca.
POSTGRES_USER="crm"
POSTGRES_PASSWORD=""
POSTGRES_DB="crm_erasmus"
# Interfaz donde escucha la aplicación. Déjalo así: el CRM debe ir detrás de
# un proxy inverso con HTTPS, no expuesto directamente a la red.
APP_BIND_ADDRESS="127.0.0.1"

# === Envío de correo: Microsoft Graph ======================================
# Dejar vacío hasta que IT registre la aplicación en Azure AD. Mientras esté
# vacío, el botón de enviar presupuestos/contratos aparece deshabilitado y el
# resto del CRM funciona con normalidad.
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""
AZURE_SENDER_EMAIL=""

# === Administrador inicial (se usa UNA sola vez) ===========================
# Las lee `npm run db:seed` / `node scripts/crear-admin.mjs` al crear la
# primera cuenta. Esa contraseña nace marcada como temporal: al entrar por
# primera vez el CRM obliga a cambiarla.
# En cuanto la cuenta esté creada y la contraseña cambiada, BORRA la línea
# SEED_ADMIN_PASSWORD de este fichero.
# Genera una larga y aleatoria:  openssl rand -hex 24
SEED_ADMIN_EMAIL="admin@tudominio.es"
SEED_ADMIN_PASSWORD=""
