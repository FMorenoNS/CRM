// Prisma schema — CRM Erasmus+ residencia Novaschool Granada
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; "debian-openssl-3.0.x" para la imagen
  // Docker (node:20-slim); "rhel-openssl-3.0.x" para las funciones
  // serverless de Vercel.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MARKETING
  DIRECCION
}

enum TipoParticipante {
  ALUMNOS
  PROFESORES
}

enum EstadoEstancia {
  INTERESADO
  CONTACTADO
  EN_CONVERSACION
  PRESUPUESTO_ENVIADO
  PRESUPUESTO_CONFIRMADO
  CONTRATO_FIRMADO
  ALOJADO
  FINALIZADO
  PERDIDO
}

enum TipoInteraccion {
  CAPTACION_FACEBOOK
  LLAMADA
  EMAIL
  WHATSAPP
  NOTA
}

enum TipoDocumento {
  PRESUPUESTO
  CONTRATO
}

// Un cliente puede ser una institución (colegio/centro) o una persona a
// título individual.
enum TipoCliente {
  CENTRO
  PERSONA
}

// Tipo de proyecto de la estancia: programa Erasmus+ o estancia privada
// (pagada directamente, fuera de fondos europeos).
enum TipoProyecto {
  ERASMUS
  PRIVADO
}

// Centro propio de Novaschool (residencia/campus) al que pertenece un
// usuario del CRM. No confundir con el "cliente" (Centro/colegio externo).
enum CentroNovaschool {
  OPENWORLD
  MEDINA_ELVIRA
  ANORETA
}

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  role         Role
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Cuando un administrador asigna una contraseña temporal, se marca a true:
  // el usuario está obligado a elegir una nueva antes de poder usar el CRM.
  debeCambiarPassword Boolean   @default(false)
  passwordUpdatedAt   DateTime?

  interacciones      Interaccion[]
  documentosEnviados DocumentoEnviado[]
  registrosHistorial AuditLog[]
  // Clientes a los que este usuario tiene acceso. Solo se aplica como
  // restricción real al rol DIRECCION (ADMIN y MARKETING ven todos los
  // clientes independientemente de esta lista).
  centros            Centro[]           @relation("UsuarioCentros")
  // Centro propio de Novaschool al que pertenece (solo informativo).
  centroAsignado     CentroNovaschool?
  apiKeys            ApiKey[]
  presupuestos       Presupuesto[]      @relation("PresupuestoActualizadoPor")
  presupuestosValidados Presupuesto[]   @relation("PresupuestoValidadoPor")
  sessions           Session[]
}

// Sesiones abiertas. El navegador guarda un token aleatorio y opaco (no
// contiene ningún dato dentro); aquí solo se guarda su huella SHA-256. Así
// una sesión se puede anular en cualquier momento borrando su fila, y una
// fuga de la base de datos no permite fabricar sesiones válidas.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

// Intentos de inicio de sesión, para frenar la fuerza bruta y para poder
// investigar accesos sospechosos. Se purgan automáticamente.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  exito     Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

// Claves de API para integraciones externas (p. ej. el bot de captación de
// Facebook). Cada clave actúa "como" el usuario al que está vinculada:
// hereda su rol y sus clientes asignados, así que la autorización no
// necesita ninguna lógica nueva aparte de la ya existente para usuarios.
model ApiKey {
  id         String    @id @default(cuid())
  nombre     String
  hash       String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activo     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Centro {
  id          String      @id @default(cuid())
  nombre      String
  tipo        TipoCliente @default(CENTRO)
  pais        String
  ciudad      String?
  // VAT/NIF y dirección postal: hacen falta para rellenar el PDF del
  // presupuesto (datos del colegio cliente). Opcionales porque los clientes
  // ya existentes no los tienen todavía.
  vat         String?
  direccion   String?
  canalOrigen String      @default("Facebook")
  notas       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  contactos Contacto[]
  estancias Estancia[]
  historial AuditLog[]
  usuarios  User[]     @relation("UsuarioCentros")

  @@index([pais])
  @@index([nombre])
}

// Datos fiscales y de contacto de cada centro propio de Novaschool
// (residencia), para rellenar el PDF del presupuesto: razón social, CIF,
// código OID y dirección. Una fila por cada valor del enum, editable solo
// por ADMIN desde Usuarios. Se guardan aparte de CentroNovaschool (que es
// solo el enum) porque son datos reales de empresa, no algo que deba
// inventarse en el código.
model CentroNovaschoolInfo {
  centro      CentroNovaschool @id
  razonSocial String?
  cif         String?
  oid         String?
  direccion   String?
  updatedAt   DateTime         @updatedAt
}

model Contacto {
  id        String   @id @default(cuid())
  centroId  String
  centro    Centro   @relation(fields: [centroId], references: [id], onDelete: Cascade)
  nombre    String
  telefono  String?
  email     String?
  cargo     String?
  createdAt DateTime @default(now())

  @@index([centroId])
}

model Estancia {
  id                 String           @id @default(cuid())
  centroId           String
  centro             Centro           @relation(fields: [centroId], references: [id], onDelete: Cascade)
  tipoPrograma       String
  tipoProyecto       TipoProyecto?
  provincia          String?
  numeroAlumnos      Int?
  numeroProfesores   Int?
  fechaInicio        DateTime?
  fechaFin           DateTime?
  edadGrupo          String?
  tipoParticipante   TipoParticipante
  centroReceptor     String           @default("Granada")
  estado             EstadoEstancia   @default(INTERESADO)
  activo             Boolean          @default(true)
  presupuestoImporte Decimal?         @db.Decimal(10, 2)
  notas              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Reserva provisional de plaza: días que dura desde que se envía el
  // presupuesto (editable, con un valor por defecto razonable) y el momento
  // en que ese envío ocurrió (lo pone el sistema solo, cada vez que el
  // presupuesto se manda al cliente). Con los dos se calcula cuándo vence y
  // se avisa en el Panel cuando quedan 2 días o menos.
  reservaDias     Int?      @default(15)
  reservaCreadaEn DateTime?

  interacciones      Interaccion[]
  documentosEnviados DocumentoEnviado[]
  participantes      Participante[]
  // Presupuesto detallado, con sus líneas. `presupuestoImporte` de arriba
  // sigue siendo el total, para que los listados, el kanban, los informes y
  // la exportación a Excel no tengan que mirar aquí.
  presupuesto        Presupuesto?

  @@index([centroId])
  @@index([estado])
}

// Catálogo de habitaciones de la residencia (una sola sede, Granada). No
// pertenece a ningún cliente: es configuración interna, la gestiona ADMIN.
model Habitacion {
  id        String   @id @default(cuid())
  nombre    String
  capacidad Int
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  participantes Participante[]

  @@index([activa])
}

// Lista nominal de personas de un grupo (estudiante o profesor
// acompañante). Deliberadamente sin datos sensibles (alergias, datos
// médicos, menor de edad, contacto de emergencia): pausado a petición del
// usuario, se añade solo si hace falta más adelante.
model Participante {
  id           String           @id @default(cuid())
  estanciaId   String
  estancia     Estancia         @relation(fields: [estanciaId], references: [id], onDelete: Cascade)
  nombre       String
  rol          TipoParticipante
  habitacionId String?
  habitacion   Habitacion?      @relation(fields: [habitacionId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Datos sensibles (antes pausados a propósito): lo mínimo que pide el
  // brief de residencia para gestionar la estancia con seguridad, nada
  // "por si acaso". "Menor de edad" no se guarda como campo: se calcula a
  // partir de fechaNacimiento y la fecha de inicio de la estancia.
  fechaNacimiento            DateTime?
  alergias                   String?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  autorizacionRecibida       Boolean   @default(false)
  seguroRecibido             Boolean   @default(false)

  @@index([estanciaId])
  @@index([habitacionId])
}

model Interaccion {
  id         String          @id @default(cuid())
  estanciaId String
  estancia   Estancia        @relation(fields: [estanciaId], references: [id], onDelete: Cascade)
  autorId    String
  autor      User            @relation(fields: [autorId], references: [id])
  tipo       TipoInteraccion
  fecha      DateTime        @default(now())
  resumen    String
  createdAt  DateTime        @default(now())

  // Campos específicos de la captación desde Facebook (tipo CAPTACION_FACEBOOK).
  // El bot (fase 2) los rellenará automáticamente; hoy se rellenan a mano.
  grupoUrl        String? // URL del grupo de Facebook donde se encontró el mensaje
  perfilUrl       String? // URL del perfil que publicó el mensaje
  capturaBase64   String? @db.Text // captura de pantalla del mensaje (data URL)
  mensajeContacto String? @db.Text // mensaje de primer contacto ya redactado

  @@index([estanciaId, fecha])
}

model DocumentoEnviado {
  id           String        @id @default(cuid())
  estanciaId   String
  estancia     Estancia      @relation(fields: [estanciaId], references: [id], onDelete: Cascade)
  tipo         TipoDocumento
  enviadoPorId String
  enviadoPor   User          @relation(fields: [enviadoPorId], references: [id])
  destinatario String
  enviadoEn    DateTime      @default(now())
  exito        Boolean       @default(true)
  detalle      String?

  @@index([estanciaId])
}

// Historial de cambios de un centro: registra qué se hizo, quién lo hizo y
// cuándo, sobre el centro o cualquiera de sus contactos/estancias/
// interacciones/documentos asociados.
model AuditLog {
  id       String  @id @default(cuid())
  // Opcional: los eventos de sistema (inicios de sesión, alta de usuarios,
  // exportaciones) no cuelgan de ningún cliente concreto.
  centroId String?
  centro   Centro? @relation(fields: [centroId], references: [id], onDelete: Cascade)
  // Opcional: un intento de acceso fallido con un email desconocido no
  // corresponde a ningún usuario existente; se guarda actorEmail en su lugar.
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorEmail String?
  accion     String
  detalle    String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([centroId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

// Tipo de línea de un presupuesto: un concepto de la tarifa (alojamiento,
// visitas, clases...) o un autobús, que en el Excel iban en bloques aparte.
enum TipoLineaPresupuesto {
  CONCEPTO
  AUTOBUS
}

// Presupuesto de una estancia, uno por estancia y reeditable: cuando el
// centro pide un cambio se reabre y se retoca, en lugar de rehacerlo.
//
// Los totales se guardan calculados (no solo las líneas) porque un
// presupuesto es un documento comercial: interesa saber qué números se
// dieron, no recalcularlos con las tarifas de hoy.
model Presupuesto {
  id         String   @id @default(cuid())
  estanciaId String   @unique
  estancia   Estancia @relation(fields: [estanciaId], references: [id], onDelete: Cascade)

  // Numeración correlativa del presupuesto (el "BUDGET NO." del PDF), propia
  // e independiente del id interno.
  numero Int @unique @default(autoincrement())

  // El grupo con el que se calculó. Los monitores no cuentan como personas
  // para el precio por persona: solo alumnos y profesores.
  numAlumnos    Int @default(0)
  numProfesores Int @default(0)
  numMonitores  Int @default(0)

  // Porcentajes aplicados, guardados con el presupuesto: si mañana cambia el
  // margen de la casa, este presupuesto sigue explicando su propio total.
  margenPct Decimal @default(0.2000) @db.Decimal(6, 4)
  ivaPct    Decimal @default(0.1000) @db.Decimal(6, 4)

  totalNeto     Decimal @default(0) @db.Decimal(10, 2)
  margenImporte Decimal @default(0) @db.Decimal(10, 2)
  ivaImporte    Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @default(0) @db.Decimal(10, 2)
  pvpPorPersona Decimal @default(0) @db.Decimal(10, 2)

  notas String?

  actualizadoPorId String?
  actualizadoPor   User?   @relation("PresupuestoActualizadoPor", fields: [actualizadoPorId], references: [id])

  // Centro(s) propios de Novaschool donde se aloja el grupo. Quien da el
  // visto bueno tiene que pertenecer a uno de estos centros: es quien de
  // verdad sabe si ese centro puede acoger al grupo.
  centrosNovaschool CentroNovaschool[]

  // Validación por una segunda persona (de uno de los centros marcados,
  // distinta de quien preparó el presupuesto) antes de poder enviarlo al
  // cliente. Se limpia en cuanto se vuelve a guardar el presupuesto: un
  // cambio en los números invalida el visto bueno anterior.
  validadoPorId String?
  validadoPor   User?     @relation("PresupuestoValidadoPor", fields: [validadoPorId], references: [id])
  validadoEn    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineas PresupuestoLinea[]

  @@index([actualizadoPorId])
  @@index([validadoPorId])
}

// Una línea del presupuesto. Guarda el nombre y el precio del momento a
// propósito: si la tarifa sube después, el presupuesto ya enviado sigue
// diciendo lo que se ofreció. El código permite reconocer el concepto al
// reabrir la ventana aunque su nombre haya cambiado en el catálogo.
model PresupuestoLinea {
  id            String      @id @default(cuid())
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  tipo           TipoLineaPresupuesto
  codigo         String
  nombre         String
  precioUnitario Decimal              @db.Decimal(10, 2)
  dias           Int                  @default(1)
  cantidad       Int                  @default(0)
  total          Decimal              @db.Decimal(10, 2)
  orden          Int                  @default(0)

  @@index([presupuestoId])
}
