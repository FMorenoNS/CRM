// Prisma schema — CRM Erasmus+ residencia Novaschool Granada
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" para desarrollo local; "debian-openssl-3.0.x" para la imagen
  // Docker (node:20-slim); "rhel-openssl-3.0.x" para las funciones
  // serverless de Vercel.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MARKETING
  DIRECCION
}

enum TipoParticipante {
  ALUMNOS
  PROFESORES
}

enum EstadoEstancia {
  INTERESADO
  CONTACTADO
  EN_CONVERSACION
  PRESUPUESTO_ENVIADO
  PRESUPUESTO_CONFIRMADO
  CONTRATO_FIRMADO
  ALOJADO
  FINALIZADO
  PERDIDO
}

enum TipoInteraccion {
  CAPTACION_FACEBOOK
  LLAMADA
  EMAIL
  WHATSAPP
  NOTA
}

enum TipoDocumento {
  PRESUPUESTO
  CONTRATO
}

// Un cliente puede ser una institución (colegio/centro) o una persona a
// título individual.
enum TipoCliente {
  CENTRO
  PERSONA
}

// Tipo de proyecto de la estancia: programa Erasmus+ o estancia privada
// (pagada directamente, fuera de fondos europeos).
enum TipoProyecto {
  ERASMUS
  PRIVADO
}

// Centro propio de Novaschool (residencia/campus) al que pertenece un
// usuario del CRM. No confundir con el "cliente" (Centro/colegio externo).
enum CentroNovaschool {
  OPENWORLD
  MEDINA_ELVIRA
}

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  role         Role
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Cuando un administrador asigna una contraseña temporal, se marca a true:
  // el usuario está obligado a elegir una nueva antes de poder usar el CRM.
  debeCambiarPassword Boolean   @default(false)
  passwordUpdatedAt   DateTime?

  interacciones      Interaccion[]
  documentosEnviados DocumentoEnviado[]
  registrosHistorial AuditLog[]
  // Clientes a los que este usuario tiene acceso. Solo se aplica como
  // restricción real al rol DIRECCION (ADMIN y MARKETING ven todos los
  // clientes independientemente de esta lista).
  centros            Centro[] @relation("UsuarioCentros")
  // Centro propio de Novaschool al que pertenece (solo informativo).
  centroAsignado     CentroNovaschool?
  apiKeys            ApiKey[]
  sessions           Session[]
}

// Sesiones abiertas. El navegador guarda un token aleatorio y opaco (no
// contiene ningún dato dentro); aquí solo se guarda su huella SHA-256. Así
// una sesión se puede anular en cualquier momento borrando su fila, y una
// fuga de la base de datos no permite fabricar sesiones válidas.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

// Intentos de inicio de sesión, para frenar la fuerza bruta y para poder
// investigar accesos sospechosos. Se purgan automáticamente.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  exito     Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

// Claves de API para integraciones externas (p. ej. el bot de captación de
// Facebook). Cada clave actúa "como" el usuario al que está vinculada:
// hereda su rol y sus clientes asignados, así que la autorización no
// necesita ninguna lógica nueva aparte de la ya existente para usuarios.
model ApiKey {
  id         String    @id @default(cuid())
  nombre     String
  hash       String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activo     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Centro {
  id          String      @id @default(cuid())
  nombre      String
  tipo        TipoCliente @default(CENTRO)
  pais        String
  ciudad      String?
  canalOrigen String      @default("Facebook")
  notas       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  contactos Contacto[]
  estancias Estancia[]
  historial AuditLog[]
  usuarios  User[] @relation("UsuarioCentros")

  @@index([pais])
  @@index([nombre])
}

model Contacto {
  id        String   @id @default(cuid())
  centroId  String
  centro    Centro   @relation(fields: [centroId], references: [id], onDelete: Cascade)
  nombre    String
  telefono  String?
  email     String?
  cargo     String?
  createdAt DateTime @default(now())

  @@index([centroId])
}

model Estancia {
  id                 String           @id @default(cuid())
  centroId           String
  centro             Centro           @relation(fields: [centroId], references: [id], onDelete: Cascade)
  tipoPrograma       String
  tipoProyecto       TipoProyecto?
  provincia          String?
  numeroAlumnos      Int?
  fechaInicio        DateTime?
  fechaFin           DateTime?
  edadGrupo          String?
  tipoParticipante   TipoParticipante
  centroReceptor     String           @default("Granada")
  estado             EstadoEstancia   @default(INTERESADO)
  activo             Boolean          @default(true)
  presupuestoImporte Decimal?         @db.Decimal(10, 2)
  notas              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  interacciones      Interaccion[]
  documentosEnviados DocumentoEnviado[]

  @@index([centroId])
  @@index([estado])
}

model Interaccion {
  id         String          @id @default(cuid())
  estanciaId String
  estancia   Estancia        @relation(fields: [estanciaId], references: [id], onDelete: Cascade)
  autorId    String
  autor      User            @relation(fields: [autorId], references: [id])
  tipo       TipoInteraccion
  fecha      DateTime        @default(now())
  resumen    String
  createdAt  DateTime        @default(now())

  // Campos específicos de la captación desde Facebook (tipo CAPTACION_FACEBOOK).
  // El bot (fase 2) los rellenará automáticamente; hoy se rellenan a mano.
  grupoUrl        String? // URL del grupo de Facebook donde se encontró el mensaje
  perfilUrl       String? // URL del perfil que publicó el mensaje
  capturaBase64   String? @db.Text // captura de pantalla del mensaje (data URL)
  mensajeContacto String? @db.Text // mensaje de primer contacto ya redactado

  @@index([estanciaId, fecha])
}

model DocumentoEnviado {
  id           String        @id @default(cuid())
  estanciaId   String
  estancia     Estancia      @relation(fields: [estanciaId], references: [id], onDelete: Cascade)
  tipo         TipoDocumento
  enviadoPorId String
  enviadoPor   User          @relation(fields: [enviadoPorId], references: [id])
  destinatario String
  enviadoEn    DateTime      @default(now())
  exito        Boolean       @default(true)
  detalle      String?

  @@index([estanciaId])
}

// Historial de cambios de un centro: registra qué se hizo, quién lo hizo y
// cuándo, sobre el centro o cualquiera de sus contactos/estancias/
// interacciones/documentos asociados.
model AuditLog {
  id       String  @id @default(cuid())
  // Opcional: los eventos de sistema (inicios de sesión, alta de usuarios,
  // exportaciones) no cuelgan de ningún cliente concreto.
  centroId String?
  centro   Centro? @relation(fields: [centroId], references: [id], onDelete: Cascade)
  // Opcional: un intento de acceso fallido con un email desconocido no
  // corresponde a ningún usuario existente; se guarda actorEmail en su lugar.
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorEmail String?
  accion     String
  detalle    String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([centroId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
}
